# Copie este arquivo para .env.local e preencha com os valores do seu projeto Supabase
# Você vai encontrar esses valores em: Supabase → Project Settings → API

VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica-aqui

# ── Billing (Asaas) — usadas só pelas funções serverless em /api, nunca no
# bundle do navegador. Configurar na Vercel: Project Settings → Environment
# Variables (Production + Preview). NÃO colocar essas no .env.local do Vite,
# senão o Vite tentaria expor pro client (prefixo VITE_ não usado de propósito).

# Service role key do Supabase (Project Settings → API → service_role) — só
# ela grava em `assinaturas` (RLS bloqueia escrita do client autenticado) e
# valida o token de sessão que a SPA manda em Authorization: Bearer <token>.
SUPABASE_SERVICE_ROLE_KEY=

# Conta Asaas própria do KyraOne (separada da do Quintalzim). Sandbox pra
# testar, produção quando for cobrar de verdade — troca só via ASAAS_API_URL.
ASAAS_API_KEY=
ASAAS_API_URL=https://api-sandbox.asaas.com/v3

# Token de acesso que o Asaas manda no header `asaas-access-token` em toda
# chamada de webhook — mesmo valor cadastrado em Configurações → Integrações
# → Webhooks no painel do Asaas, aponta pra /api/asaas/webhook.
ASAAS_WEBHOOK_TOKEN=
