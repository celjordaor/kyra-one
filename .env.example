# Copie este arquivo para .env.local e preencha com os valores do seu projeto Supabase
# Você vai encontrar esses valores em: Supabase → Project Settings → API

VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica-aqui

# Usadas pelas Netlify Functions (netlify/functions/mp-webhook.js e create-checkout.js).
# Em produção, configure também no painel da Netlify (Site settings → Environment variables).
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui
